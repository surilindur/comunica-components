{
  "name": "@comunica/query-sparql-prototype",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index",
  "lsd:module": true,
  "bin": {
    "comunica-dynamic-sparql-prototype": "bin/query-dynamic.js",
    "comunica-sparql-prototype": "bin/query.js",
    "comunica-sparql-prototype-http": "bin/http.js"
  },
  "scripts": {
    "prepare": "comunica-compile-config config/config-default.json > engine-default.js",
    "spec:base-1-1": "rdf-test-suite spec/sparql-engine.js https://w3c.github.io/rdf-tests/sparql/sparql11/manifest-all.ttl -c ../../.rdf-test-suite-cache/",
    "spec:base-1-2": "rdf-test-suite spec/sparql-engine.js https://w3c.github.io/rdf-tests/sparql/sparql12/manifest.ttl -c ../../.rdf-test-suite-cache/",
    "spec:query-1-1": "yarn run spec:base-1-1 -s http://www.w3.org/TR/sparql11-query/ --skip \"(agg-empty-group-count-graph|bindings/manifest#graph)\"",
    "spec:query-1-2": "yarn run spec:base-1-2",
    "spec:update-1-1": "yarn run spec:base-1-1 -s http://www.w3.org/TR/sparql11-update/",
    "spec:csv-tsv-1-1": "yarn run spec:base-1-1 -s http://www.w3.org/TR/sparql11-results-csv-tsv/",
    "spec:json-1-1": "yarn run spec:base-1-1 -s http://www.w3.org/TR/sparql11-results-json/",
    "spec:fed-1-1": "yarn run spec:base-1-1 -s http://www.w3.org/TR/sparql11-federated-query/",
    "spec:sd-1-1": "yarn run spec:base-1-1 -s http://www.w3.org/TR/sparql11-service-description/",
    "spec:prot-1-1": "yarn run spec:base-1-1 -s http://www.w3.org/TR/sparql11-protocol/",
    "spec:graphstore-1-1": "yarn run spec:base-1-1 -s http://www.w3.org/TR/sparql11-http-rdf-update/",
    "spec:sparql12-xsd-datetime-duration": "rdf-test-suite spec/sparql-engine.js https://raw.githubusercontent.com/kasei/sparql-12/xsd_datetime_duration/tests/xsd_functions/manifest.ttl -c ../../.rdf-test-suite-cache/ --skip \"http://www.w3.org/2009/sparql/docs/tests/data-sparql11/functions/manifest#adjust_.*\"",
    "spec": "yarn run spec:query-1-1 && yarn run spec:update-1-1 && yarn run spec:csv-tsv-1-1 && yarn run spec:json-1-1 && yarn run spec:sparql12-xsd-datetime-duration && yarn run spec:query-1-2",
    "integration": "rdf-test-suite-ldf spec/sparql-engine.js https://comunica.github.io/manifest-ldf-tests/sparql/sparql-manifest.ttl -d 200000 -c ../../.rdf-test-suite-ldf-cache/"
  },
  "dependencies": {
    "@comunica/actor-context-preprocess-prototype": "^0.0.0",
    "@comunica/actor-http-delay": "^0.0.0",
    "@comunica/actor-http-limit-rate": "^5.0.0",
    "@comunica/actor-init-query": "^5.0.0",
    "@comunica/actor-optimize-query-operation-distinct-terms-pushdown": "^5.0.0",
    "@comunica/actor-optimize-query-operation-group-file-sources": "^5.0.0",
    "@comunica/actor-query-operation-nodes": "^5.0.0",
    "@comunica/actor-rdf-join-entries-sort-selectivity": "^5.0.0",
    "@comunica/actor-rdf-join-inner-restart": "^0.0.0",
    "@comunica/actor-rdf-metadata-accumulate-cardinality-void": "^0.0.0",
    "@comunica/actor-rdf-metadata-extract-link-filter-bloom": "^0.0.0",
    "@comunica/actor-rdf-metadata-extract-link-filter-void": "^0.0.0",
    "@comunica/actor-rdf-metadata-extract-void": "^5.0.0",
    "@comunica/actor-rdf-resolve-hypermedia-links-queue-wrapper-filter": "^0.8.0",
    "@comunica/config-query-sparql-prototype": "^0.0.0",
    "@comunica/query-sparql-link-traversal-solid": "^0.8.0",
    "@comunica/runner": "^5.0.0",
    "@comunica/runner-cli": "^5.0.0"
  }
}
